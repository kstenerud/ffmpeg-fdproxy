-            if (d->loop) {
+            /* An input whose reads failed is not looped: it would fail
+             * again at once, for ever. */
+            if (d->loop && !(f->ctx->pb && f->ctx->pb->error < 0 &&
+                             f->ctx->pb->error != AVERROR(EAGAIN))) {
