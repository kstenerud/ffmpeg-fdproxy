     }
 
+    /* An input whose reads failed fails the run, where it would otherwise
+     * end as if the input had simply ended. */
+    if ((ret >= 0 || ret == AVERROR_EOF || ret == AVERROR_EXIT) &&
+        f->ctx->pb && f->ctx->pb->error < 0 &&
+        f->ctx->pb->error != AVERROR(EAGAIN)) {
+        ret = f->ctx->pb->error == AVERROR_EXIT ? AVERROR(EINTR)
+                                                : f->ctx->pb->error;
+        av_log(d, AV_LOG_ERROR, "Reading the input failed: %s\n",
+               av_err2str(ret));
+    }
+
     // EOF/EXIT is normal termination
     if (ret == AVERROR_EOF || ret == AVERROR_EXIT)
         ret = 0;
