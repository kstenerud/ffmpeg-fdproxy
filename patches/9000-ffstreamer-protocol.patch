+#include "config.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "libavutil/avstring.h"
+#include "libavutil/error.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/thread.h"
+
+#include "avformat.h"
+#include "url.h"
+
+#define FFS_VERSION_LOWEST   1
+#define FFS_VERSION_HIGHEST  1
+
+#define FFS_HEADER_BYTES     6
+#define FFS_MAX_SENT_FRAME   4096
+#define FFS_MAX_OUTSTANDING  16
+#define FFS_WAIT_SLICE_MS    100
+#define FFS_MESSAGE_MAX      1024
+
+/* What this side offers in CAPABILITY. */
+#define FFS_PREFERRED_BLOCK  (1 << 20)
+#define FFS_LARGEST_BODY     (4 << 20)
+#define FFS_OUTSTANDING_CAP  2
+
+/* The largest file size a REQUEST may give (the specification's Checks
+ * Without Overflow): headroom, so the size plus a block, a READ or a seek
+ * from the end stays below INT64_MAX. */
+#define FFS_LARGEST_FILE     (INT64_C(1) << 62)
+
+enum FFStreamerType {
+    FFS_HELLO      = 1,
+    FFS_CAPABILITY = 2,
+    FFS_REQUEST    = 3,
+    FFS_READ       = 4,
+    FFS_DATA       = 5,
+    FFS_DONE       = 6,
+};
+
+enum FFStreamerKind {
+    FFS_KIND_TERMS       = 1,
+    FFS_KIND_CHANNEL     = 2,
+    FFS_KIND_PROTOCOL    = 3,
+    FFS_KIND_INTERRUPTED = 4,
+};
+
+/** One block of the file in the cache. */
+typedef struct FFStreamerBlock {
+    int64_t index;      ///< the block's number in the file, or -1 when free
+    int32_t length;     ///< its length: the block size, or less for the last
+    int64_t last_used;  ///< when it was last read, by the session's use_clock
+    int     pending;    ///< its READ is outstanding
+    uint8_t *data;      ///< its bytes, the block size allocated
+} FFStreamerBlock;
+
+/** A READ sent and not yet answered. */
+typedef struct FFStreamerOutstanding {
+    int8_t  sequence;   ///< the READ's number, which its DATA carries
+    int64_t offset;     ///< where in the file it starts
+    int32_t length;     ///< how many bytes it asked for
+    int     slot;       ///< the cache block its DATA goes into
+} FFStreamerOutstanding;
+
+typedef struct FFStreamerContext {
+    const AVClass *class;
+    int read_fd_option;  ///< the caller's descriptor the parent's messages arrive on
+    int write_fd_option; ///< the caller's descriptor this side's messages go out on
+    int cache_blocks;   ///< how many blocks the cache holds
+
+    int read_fd;        ///< the session's own duplicate of read_fd_option
+    int write_fd;       ///< the session's own duplicate of write_fd_option
+
+    int     accepted;   ///< REQUEST's terms were taken
+    int64_t run;        ///< the parent's number for the run, from REQUEST
+    int64_t size;       ///< the file's size, from REQUEST
+    int32_t block;      ///< the block size, from REQUEST
+    int32_t longest;    ///< the longest READ, from REQUEST
+    int8_t  outstanding_allowed; ///< READs that may be outstanding at once
+
+    int8_t  next_sequence; ///< the number the next frame sent takes
+
+    FFStreamerBlock *blocks; ///< the cache, cache_blocks of them
+    int64_t use_clock;  ///< counts reads, to find the least recently used
+
+    /** The READs sent and not yet answered, oldest first, as a ring. */
+    FFStreamerOutstanding outstanding[FFS_MAX_OUTSTANDING];
+    int outstanding_first; ///< the oldest's place in the ring
+    int outstanding_count; ///< how many there are
+
+    int64_t position;   ///< where the next read starts
+    int64_t last_needed; ///< the block the last read needed, for prefetch
+
+    int fault;          ///< a sticky AVERROR, 0 while healthy
+    int fault_kind;     ///< DONE's kind for the fault
+    int done_sent;      ///< DONE has been sent
+
+    int     claimed;    ///< the channel's pipes are claimed for this session
+    dev_t   claimed_device[2]; ///< the claimed pipes' devices, read then write
+    ino_t   claimed_inode[2];  ///< the claimed pipes' inodes, read then write
+    struct FFStreamerContext *next_claim; ///< the next session claimed
+} FFStreamerContext;
+
+/* The sessions open in this process, by their pipes: a pipe serves one
+ * session at a time, through whichever descriptor reaches it. */
+static AVMutex claims_lock = AV_MUTEX_INITIALIZER;
+static FFStreamerContext *claims;
+
+/** Checks that fd is a pipe open for access_mode, and gives its identity. */
+static int check_descriptor(URLContext *h, int fd, int access_mode,
+                            struct stat *facts)
+{
+    int flags;
+
+    if (fstat(fd, facts) < 0 || !S_ISFIFO(facts->st_mode)) {
+        av_log(h, AV_LOG_ERROR, "Descriptor %d is not a pipe\n", fd);
+        return AVERROR(EBADF);
+    }
+    flags = fcntl(fd, F_GETFL);
+    if (flags < 0 || (flags & O_ACCMODE) != access_mode) {
+        av_log(h, AV_LOG_ERROR, "Descriptor %d is not open for its direction\n",
+               fd);
+        return AVERROR(EBADF);
+    }
+    return 0;
+}
+
+/**
+ * Claims the session's two pipes for as long as it is open: EBUSY when
+ * another open session has either, EBADF when a descriptor is not a pipe
+ * open for its direction.
+ */
+static int claim_channel(URLContext *h)
+{
+    FFStreamerContext *c = h->priv_data;
+    struct stat facts[2];
+    int ret;
+
+    if ((ret = check_descriptor(h, c->read_fd_option, O_RDONLY, &facts[0])) < 0 ||
+        (ret = check_descriptor(h, c->write_fd_option, O_WRONLY, &facts[1])) < 0)
+        return ret;
+    ff_mutex_lock(&claims_lock);
+    for (FFStreamerContext *other = claims; other; other = other->next_claim)
+        for (int mine = 0; mine < 2; mine++)
+            for (int theirs = 0; theirs < 2; theirs++)
+                if (other->claimed_device[theirs] == facts[mine].st_dev &&
+                    other->claimed_inode[theirs] == facts[mine].st_ino)
+                    ret = AVERROR(EBUSY);
+    if (!ret) {
+        for (int i = 0; i < 2; i++) {
+            c->claimed_device[i] = facts[i].st_dev;
+            c->claimed_inode[i]  = facts[i].st_ino;
+        }
+        c->next_claim = claims;
+        claims        = c;
+        c->claimed    = 1;
+    }
+    ff_mutex_unlock(&claims_lock);
+    if (ret)
+        av_log(h, AV_LOG_ERROR,
+               "The channel on descriptors %d and %d is open already\n",
+               c->read_fd_option, c->write_fd_option);
+    return ret;
+}
+
+/** Lets the session's pipe go, if it was claimed. */
+static void release_channel(FFStreamerContext *c)
+{
+    if (!c->claimed)
+        return;
+    ff_mutex_lock(&claims_lock);
+    for (FFStreamerContext **at = &claims; *at; at = &(*at)->next_claim) {
+        if (*at == c) {
+            *at = c->next_claim;
+            break;
+        }
+    }
+    ff_mutex_unlock(&claims_lock);
+    c->claimed    = 0;
+    c->next_claim = NULL;
+}
+
+static int8_t next_sequence(int8_t sequence)
+{
+    return (int8_t)((sequence + 1) % 128);
+}
+
+/* --- Writing ------------------------------------------------------------ */
+
+/**
+ * Waits, in slices, for the pipe to take a frame, checking FFmpeg's
+ * interrupt between them. A frame is never larger than PIPE_BUF, so a pipe
+ * that has room takes it whole without blocking.
+ */
+static int wait_for_room(URLContext *h)
+{
+    FFStreamerContext *c = h->priv_data;
+
+    for (;;) {
+        struct pollfd room = { .fd = c->write_fd, .events = POLLOUT };
+        int ready = poll(&room, 1, FFS_WAIT_SLICE_MS);
+
+        if (ready > 0)
+            return 0; /* room, or the pipe's end: write() says which */
+        if (ready < 0 && errno != EINTR)
+            return AVERROR(errno);
+        if (ff_check_interrupt(&h->interrupt_callback))
+            return AVERROR_EXIT;
+    }
+}
+
+/**
+ * Numbers a frame and writes it whole, in one write(), once the pipe has room
+ * for it. A parent that has gone raises SIGPIPE, which the program ignores,
+ * as for any pipe FFmpeg writes.
+ */
+static int write_frame(URLContext *h, uint8_t type, const uint8_t *body,
+                       int32_t body_length, int8_t *sequence_out)
+{
+    FFStreamerContext *c = h->priv_data;
+    uint8_t frame[FFS_MAX_SENT_FRAME];
+    ssize_t written;
+    int ret;
+
+    if (body_length < 0 || body_length > FFS_MAX_SENT_FRAME - FFS_HEADER_BYTES)
+        return AVERROR(EINVAL);
+
+    frame[0] = type;
+    frame[1] = (uint8_t)c->next_sequence;
+    AV_WL32(frame + 2, (uint32_t)body_length);
+    if (body_length)
+        memcpy(frame + FFS_HEADER_BYTES, body, body_length);
+
+    do {
+        if ((ret = wait_for_room(h)) < 0)
+            return ret;
+        written = write(c->write_fd, frame, FFS_HEADER_BYTES + body_length);
+    } while (written < 0 && (errno == EINTR || errno == EAGAIN));
+
+    if (written < 0)
+        return AVERROR(errno);
+    if (written != FFS_HEADER_BYTES + body_length)
+        return AVERROR(EIO); /* a pipe takes a frame this small whole */
+    if (sequence_out)
+        *sequence_out = c->next_sequence;
+    c->next_sequence = next_sequence(c->next_sequence);
+    return 0;
+}
+
+/* --- Reading ------------------------------------------------------------ */
+
+/**
+ * Reads exactly length bytes, waiting as long as the parent likes, in
+ * slices, checking FFmpeg's interrupt at every pass, so a parent that sends
+ * a byte at a time cannot keep it unseen. End-of-file is the channel ending.
+ */
+static int read_exact(URLContext *h, uint8_t *buffer, int64_t length)
+{
+    FFStreamerContext *c = h->priv_data;
+    int64_t got = 0;
+
+    while (got < length) {
+        struct pollfd waiting = { .fd = c->read_fd, .events = POLLIN };
+        int ready = poll(&waiting, 1, FFS_WAIT_SLICE_MS);
+        ssize_t n;
+
+        if (ready < 0 && errno != EINTR)
+            return AVERROR(errno);
+        if (ff_check_interrupt(&h->interrupt_callback))
+            return AVERROR_EXIT;
+        if (ready <= 0)
+            continue; /* a slice passed, or a signal came */
+        n = read(c->read_fd, buffer + got, (size_t)FFMIN(length - got, INT_MAX));
+        if (n < 0) {
+            if (errno == EINTR || errno == EAGAIN)
+                continue;
+            return AVERROR(errno);
+        }
+        if (!n)
+            return AVERROR_EOF;
+        got += n;
+    }
+    return 0;
+}
+
+/** Reads a header and checks its type, sequence and exact or bounded length. */
+static int read_header(URLContext *h, uint8_t expected_type,
+                       int8_t expected_sequence, int32_t expected_length,
+                       int32_t *length_out)
+{
+    uint8_t header[FFS_HEADER_BYTES];
+    int32_t length;
+    int ret;
+
+    if ((ret = read_exact(h, header, FFS_HEADER_BYTES)) < 0)
+        return ret;
+    length = (int32_t)AV_RL32(header + 2);
+    if (header[0] != expected_type || (int8_t)header[1] != expected_sequence ||
+        length < 0 || (expected_length >= 0 && length != expected_length)) {
+        av_log(h, AV_LOG_ERROR,
+               "The parent sent type %d, number %d, length %d; "
+               "expected type %d, number %d, length %d\n",
+               header[0], (int8_t)header[1], length,
+               expected_type, expected_sequence, expected_length);
+        return AVERROR_INVALIDDATA;
+    }
+    if (length_out)
+        *length_out = length;
+    return 0;
+}
+
+/* --- Faults and DONE ---------------------------------------------------- */
+
+/** The kind DONE reports for an error. */
+static int kind_of(int error)
+{
+    if (error == AVERROR_EXIT)
+        return FFS_KIND_INTERRUPTED;
+    if (error == AVERROR_INVALIDDATA)
+        return FFS_KIND_PROTOCOL;
+    return FFS_KIND_CHANNEL;
+}
+
+/**
+ * Records the first fault; every later read returns it. The channel ending is
+ * an I/O error, never end-of-file: a parent that died must not look like the
+ * end of the film. Nor is it EAGAIN, which the caller would retry for ever.
+ */
+static int set_fault(FFStreamerContext *c, int error)
+{
+    if (error == AVERROR_EOF || error == AVERROR(EAGAIN))
+        error = AVERROR(EIO);
+    if (!c->fault) {
+        c->fault = error;
+        c->fault_kind = kind_of(error);
+    }
+    return c->fault;
+}
+
+/**
+ * Sends DONE, once: kind 0 for a session that ended well, otherwise the
+ * fault's kind, error code and message.
+ */
+static void send_done(URLContext *h, int kind, int error)
+{
+    FFStreamerContext *c = h->priv_data;
+    uint8_t body[16 + FFS_MESSAGE_MAX];
+    int32_t length = 9;
+
+    if (c->done_sent)
+        return;
+    c->done_sent = 1;
+
+    AV_WL64(body, (uint64_t)(c->run >= 1 ? c->run : 0));
+    if (!kind) {
+        body[8] = 0;
+    } else {
+        char message[FFS_MESSAGE_MAX + 1] = "";
+        int32_t code = (error < 0 && error != INT_MIN) ? -error : 0;
+        size_t message_length;
+        av_strerror(error, message, sizeof(message));
+        message_length = av_strnlen(message, FFS_MESSAGE_MAX);
+        body[8] = 1;
+        body[9] = (uint8_t)kind;
+        AV_WL32(body + 10, (uint32_t)code);
+        AV_WL16(body + 14, (uint16_t)message_length);
+        memcpy(body + 16, message, message_length);
+        length = 16 + (int32_t)message_length;
+    }
+    if (write_frame(h, FFS_DONE, body, length, NULL) < 0)
+        av_log(h, AV_LOG_WARNING, "DONE could not be sent; the parent has gone\n");
+}
+
+/* --- Opening ------------------------------------------------------------ */
+
+/**
+ * The session's own duplicate of a descriptor the caller gave, close-on-exec,
+ * as fd: makes one: the caller's is never closed or changed here.
+ */
+static int duplicate(URLContext *h, int fd)
+{
+    int copy;
+
+#ifdef F_DUPFD_CLOEXEC
+    copy = fcntl(fd, F_DUPFD_CLOEXEC, 0);
+#else
+    copy = dup(fd);
+#endif
+    if (copy < 0) {
+        int ret = AVERROR(errno);
+        av_log(h, AV_LOG_ERROR, "Descriptor %d could not be duplicated\n", fd);
+        return ret;
+    }
+    if (fcntl(copy, F_SETFD, FD_CLOEXEC) < 0)
+        av_log(h, AV_LOG_DEBUG, "Failed to set close on exec\n");
+    return copy;
+}
+
+/**
+ * Sends this side's HELLO and reads the parent's: the highest version both
+ * speak, or a negative AVERROR.
+ */
+static int exchange_hellos(URLContext *h)
+{
+    uint8_t body[4];
+    int16_t lowest, highest;
+    int ret;
+
+    AV_WL16(body, FFS_VERSION_LOWEST);
+    AV_WL16(body + 2, FFS_VERSION_HIGHEST);
+    if ((ret = write_frame(h, FFS_HELLO, body, 4, NULL)) < 0 ||
+        (ret = read_header(h, FFS_HELLO, 0, 4, NULL)) < 0 ||
+        (ret = read_exact(h, body, 4)) < 0)
+        return ret;
+    lowest = (int16_t)AV_RL16(body);
+    highest = (int16_t)AV_RL16(body + 2);
+    if (lowest < 1 || highest < lowest ||
+        FFMIN(highest, FFS_VERSION_HIGHEST) <
+        FFMAX(lowest, FFS_VERSION_LOWEST)) {
+        av_log(h, AV_LOG_ERROR,
+               "The parent speaks versions %d to %d, this side %d to %d\n",
+               lowest, highest, FFS_VERSION_LOWEST, FFS_VERSION_HIGHEST);
+        return AVERROR_INVALIDDATA;
+    }
+    return FFMIN(highest, FFS_VERSION_HIGHEST);
+}
+
+/**
+ * Returns 0 for good terms, a negative AVERROR for a malformed REQUEST
+ * (no DONE), or 1 for well-formed terms that break the rules (DONE TERMS).
+ */
+static int receive_request(URLContext *h, int version,
+                           int8_t capability_sequence)
+{
+    FFStreamerContext *c = h->priv_data;
+    uint8_t body[27];
+    int16_t request_version;
+    int ret;
+
+    if ((ret = read_header(h, FFS_REQUEST, capability_sequence, 27, NULL)) < 0 ||
+        (ret = read_exact(h, body, 27)) < 0)
+        return ret;
+
+    request_version         = (int16_t)AV_RL16(body);
+    c->run                  = (int64_t)AV_RL64(body + 2);
+    c->size                 = (int64_t)AV_RL64(body + 10);
+    c->block                = (int32_t)AV_RL32(body + 18);
+    c->longest              = (int32_t)AV_RL32(body + 22);
+    c->outstanding_allowed  = (int8_t)body[26];
+
+    if (request_version < 0 || c->run < 0 || c->size < 0 || c->block < 0 ||
+        c->longest < 0 || c->outstanding_allowed < 0) {
+        av_log(h, AV_LOG_ERROR, "REQUEST has a negative field\n");
+        return AVERROR_INVALIDDATA;
+    }
+    if (request_version != version || c->run < 1 ||
+        c->size > FFS_LARGEST_FILE ||
+        c->block < 1 || c->block > FFS_LARGEST_BODY ||
+        c->longest < c->block || c->longest > FFS_LARGEST_BODY ||
+        c->outstanding_allowed < 1 ||
+        c->outstanding_allowed > FFS_OUTSTANDING_CAP) {
+        av_log(h, AV_LOG_ERROR,
+               "REQUEST's terms are outside what this side offered\n");
+        return 1;
+    }
+    return 0;
+}
+
+/** Closes the session's duplicates, never the caller's, and ends its claim. */
+static void close_descriptors(FFStreamerContext *c)
+{
+    release_channel(c);
+    if (c->read_fd >= 0)
+        close(c->read_fd);
+    if (c->write_fd >= 0)
+        close(c->write_fd);
+    c->read_fd = c->write_fd = -1;
+}
+
+static void free_cache(FFStreamerContext *c)
+{
+    if (c->blocks) {
+        for (int i = 0; i < c->cache_blocks; i++)
+            av_freep(&c->blocks[i].data);
+        av_freep(&c->blocks);
+    }
+}
+
+static int ffstreamer_open(URLContext *h, const char *url, int flags)
+{
+    FFStreamerContext *c = h->priv_data;
+    uint8_t body[9];
+    int8_t capability_sequence;
+    int64_t blocks_in_file;
+    int version, ret;
+
+    /* The session works on duplicates of the caller's descriptors, as fd:
+     * does, and never closes or changes the caller's: whatever the outcome,
+     * they are the caller's to close. */
+    c->read_fd = c->write_fd = -1;
+    if (strcmp(url, "ffstreamer:")) {
+        av_log(h, AV_LOG_ERROR, "The URL must be exactly \"ffstreamer:\"\n");
+        return AVERROR(EINVAL);
+    }
+    if (flags & AVIO_FLAG_WRITE)
+        return AVERROR(EINVAL);
+    if (c->read_fd_option <= STDERR_FILENO ||
+        c->write_fd_option <= STDERR_FILENO ||
+        c->read_fd_option == c->write_fd_option) {
+        av_log(h, AV_LOG_ERROR, "-read_fd and -write_fd are required, "
+               "distinct, and neither stdin, stdout nor stderr\n");
+        return AVERROR(EINVAL);
+    }
+    if ((ret = claim_channel(h)) < 0)
+        return ret;
+    if ((ret = c->read_fd = duplicate(h, c->read_fd_option)) < 0 ||
+        (ret = c->write_fd = duplicate(h, c->write_fd_option)) < 0)
+        goto fail;
+
+    c->next_sequence = 0;
+    c->last_needed = -2;
+    if ((version = exchange_hellos(h)) < 0) {
+        ret = version;
+        goto fail;
+    }
+
+    AV_WL32(body, FFS_PREFERRED_BLOCK);
+    AV_WL32(body + 4, FFS_LARGEST_BODY);
+    body[8] = FFS_OUTSTANDING_CAP;
+    ret = write_frame(h, FFS_CAPABILITY, body, 9, &capability_sequence);
+    if (ret < 0)
+        goto fail;
+
+    ret = receive_request(h, version, capability_sequence);
+    if (ret < 0)
+        goto fail;
+    if (ret == 1) {
+        send_done(h, FFS_KIND_TERMS, AVERROR(EINVAL));
+        ret = AVERROR(EINVAL);
+        goto fail;
+    }
+
+    /* No more blocks than the file has, but room for every READ that may
+     * be outstanding and the block being read. */
+    blocks_in_file = c->size / c->block + !!(c->size % c->block);
+    if (c->cache_blocks > blocks_in_file)
+        c->cache_blocks = (int)FFMAX(blocks_in_file, 1);
+    if (c->cache_blocks < c->outstanding_allowed + 1)
+        c->cache_blocks = c->outstanding_allowed + 1;
+    c->blocks = av_calloc(c->cache_blocks, sizeof(*c->blocks));
+    if (!c->blocks)
+        goto out_of_memory;
+    for (int i = 0; i < c->cache_blocks; i++) {
+        c->blocks[i].index = -1;
+        c->blocks[i].data = av_malloc(c->block);
+        if (!c->blocks[i].data)
+            goto out_of_memory;
+    }
+
+    c->accepted = 1;
+    return 0;
+
+out_of_memory:
+    send_done(h, FFS_KIND_TERMS, AVERROR(ENOMEM));
+    ret = AVERROR(ENOMEM);
+fail:
+    /* Neither end-of-file nor EAGAIN, which the caller would retry. */
+    if (ret == AVERROR_EOF || ret == AVERROR(EAGAIN))
+        ret = AVERROR(EIO);
+    /* FFmpeg never calls the close of an open that failed. */
+    free_cache(c);
+    close_descriptors(c);
+    return ret;
+}
+
+/* --- The block cache ----------------------------------------------------- */
+
+/** The slot holding block index, or -1. */
+static int find_block(FFStreamerContext *c, int64_t index)
+{
+    for (int i = 0; i < c->cache_blocks; i++)
+        if (c->blocks[i].index == index)
+            return i;
+    return -1;
+}
+
+/** The least recently used block that no outstanding READ will fill. */
+static int free_slot(FFStreamerContext *c)
+{
+    int chosen = -1;
+    for (int i = 0; i < c->cache_blocks; i++) {
+        if (c->blocks[i].pending)
+            continue;
+        if (c->blocks[i].index < 0)
+            return i;
+        if (chosen < 0 || c->blocks[i].last_used < c->blocks[chosen].last_used)
+            chosen = i;
+    }
+    return chosen;
+}
+
+static int32_t block_length(FFStreamerContext *c, int64_t index)
+{
+    int64_t start = index * c->block;
+    return (int32_t)FFMIN((int64_t)c->block, c->size - start);
+}
+
+/** Asks the parent for block index, into a free slot. */
+static int send_read(URLContext *h, int64_t index)
+{
+    FFStreamerContext *c = h->priv_data;
+    FFStreamerOutstanding *entry;
+    uint8_t body[12];
+    int slot = free_slot(c), ret;
+    int32_t length = block_length(c, index);
+    int8_t sequence;
+
+    if (slot < 0)
+        return AVERROR_BUG; /* the cache is larger than what may be outstanding */
+    AV_WL64(body, (uint64_t)(index * c->block));
+    AV_WL32(body + 8, (uint32_t)length);
+    if ((ret = write_frame(h, FFS_READ, body, 12, &sequence)) < 0)
+        return set_fault(c, ret);
+
+    c->blocks[slot].index = index;
+    c->blocks[slot].length = length;
+    c->blocks[slot].pending = 1;
+    entry = &c->outstanding[(c->outstanding_first + c->outstanding_count) %
+                            FFS_MAX_OUTSTANDING];
+    entry->sequence = sequence;
+    entry->offset = index * c->block;
+    entry->length = length;
+    entry->slot = slot;
+    c->outstanding_count++;
+    return 0;
+}
+
+/** Takes the answer to the oldest outstanding READ into its block. */
+static int receive_data(URLContext *h)
+{
+    FFStreamerContext *c = h->priv_data;
+    FFStreamerOutstanding *oldest = &c->outstanding[c->outstanding_first];
+    int ret;
+
+    ret = read_header(h, FFS_DATA, oldest->sequence, oldest->length, NULL);
+    if (ret < 0)
+        return set_fault(c, ret);
+    /* The slot is freed no earlier than reading the DATA header (the
+     * specification's READ). */
+    c->outstanding_first = (c->outstanding_first + 1) % FFS_MAX_OUTSTANDING;
+    c->outstanding_count--;
+    if ((ret = read_exact(h, c->blocks[oldest->slot].data, oldest->length)) < 0)
+        return set_fault(c, ret);
+    c->blocks[oldest->slot].pending = 0;
+    c->blocks[oldest->slot].last_used = ++c->use_clock;
+    return 0;
+}
+
+/** Whether a READ for block index is awaiting its DATA. */
+static int is_outstanding(FFStreamerContext *c, int64_t index)
+{
+    for (int i = 0; i < c->outstanding_count; i++)
+        if (c->outstanding[(c->outstanding_first + i) %
+                           FFS_MAX_OUTSTANDING].offset == index * c->block)
+            return 1;
+    return 0;
+}
+
+static int ffstreamer_read(URLContext *h, unsigned char *buf, int size)
+{
+    FFStreamerContext *c = h->priv_data;
+    int64_t index, blocks_in_file, within;
+    int slot, ret;
+
+    if (c->fault)
+        return c->fault;
+    if (c->done_sent)
+        return AVERROR(EIO);
+    if (c->position >= c->size)
+        return AVERROR_EOF;
+
+    index = c->position / c->block;
+    /* Rounded up without adding: a size near INT64_MAX must not overflow. */
+    blocks_in_file = c->size / c->block + !!(c->size % c->block);
+
+    if ((slot = find_block(c, index)) < 0) {
+        while (c->outstanding_count >= c->outstanding_allowed)
+            if ((ret = receive_data(h)) < 0)
+                return ret;
+        if ((slot = find_block(c, index)) < 0 &&
+            (ret = send_read(h, index)) < 0)
+            return ret;
+    }
+
+    /* The block about to be read is the most recently used, so a prefetch
+     * never evicts it. */
+    if (slot >= 0)
+        c->blocks[slot].last_used = ++c->use_clock;
+
+    /* Prefetch when reading straight through. */
+    if (index == c->last_needed + 1 && index + 1 < blocks_in_file &&
+        find_block(c, index + 1) < 0 && !is_outstanding(c, index + 1) &&
+        c->outstanding_count < c->outstanding_allowed && free_slot(c) >= 0 &&
+        (ret = send_read(h, index + 1)) < 0)
+        return ret;
+
+    while ((slot = find_block(c, index)) < 0 || c->blocks[slot].pending)
+        if ((ret = receive_data(h)) < 0)
+            return ret;
+
+    c->last_needed = index;
+    c->blocks[slot].last_used = ++c->use_clock;
+    within = c->position - index * c->block;
+    ret = (int)FFMIN((int64_t)size, c->blocks[slot].length - within);
+    memcpy(buf, c->blocks[slot].data + within, ret);
+    c->position += ret;
+    return ret;
+}
+
+static int64_t ffstreamer_seek(URLContext *h, int64_t position, int whence)
+{
+    FFStreamerContext *c = h->priv_data;
+    int64_t target, base;
+
+    switch (whence) {
+    case AVSEEK_SIZE: return c->size;
+    case SEEK_SET:    base = 0;           break;
+    case SEEK_CUR:    base = c->position; break;
+    case SEEK_END:    base = c->size;     break;
+    default:          return AVERROR(EINVAL);
+    }
+    /* base is never negative, so only a sum past INT64_MAX can overflow. */
+    if (position > INT64_MAX - base)
+        return AVERROR(EINVAL);
+    target = base + position;
+    if (target < 0)
+        return AVERROR(EINVAL);
+    c->position = target;
+    return target;
+}
+
+static int ffstreamer_close(URLContext *h)
+{
+    FFStreamerContext *c = h->priv_data;
+
+    if (c->accepted)
+        send_done(h, c->fault ? c->fault_kind : 0, c->fault);
+    free_cache(c);
+    close_descriptors(c);
+    return 0;
+}
+
+#define OFFSET(x) offsetof(FFStreamerContext, x)
+#define D AV_OPT_FLAG_DECODING_PARAM
+static const AVOption ffstreamer_options[] = {
+    { "read_fd",      "The descriptor the parent's messages arrive on", OFFSET(read_fd_option),  AV_OPT_TYPE_INT, { .i64 = -1 }, -1, INT_MAX, D },
+    { "write_fd",     "The descriptor this side's messages go out on",  OFFSET(write_fd_option), AV_OPT_TYPE_INT, { .i64 = -1 }, -1, INT_MAX, D },
+    { "cache_blocks", "How many of the parent's blocks to keep",        OFFSET(cache_blocks),    AV_OPT_TYPE_INT, { .i64 = 32 },  2,  1024,    D },
+    /* ffmpeg-ffstreamer only: the names before 2026-10-24, until its users move. */
+    { "ffstreamer_read_fd",      "Deprecated, use read_fd",      OFFSET(read_fd_option),  AV_OPT_TYPE_INT, { .i64 = -1 }, -1, INT_MAX, D },
+    { "ffstreamer_write_fd",     "Deprecated, use write_fd",     OFFSET(write_fd_option), AV_OPT_TYPE_INT, { .i64 = -1 }, -1, INT_MAX, D },
+    { "ffstreamer_cache_blocks", "Deprecated, use cache_blocks", OFFSET(cache_blocks),    AV_OPT_TYPE_INT, { .i64 = 32 },  2,  1024,    D },
+    /* ffmpeg-ffstreamer only: end. */
+    { NULL }
+};
+
+static const AVClass ffstreamer_class = {
+    .class_name = "ffstreamer",
+    .item_name  = av_default_item_name,
+    .option     = ffstreamer_options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+const URLProtocol ff_ffstreamer_protocol = {
+    .name                = "ffstreamer",
+    .url_open            = ffstreamer_open,
+    .url_read            = ffstreamer_read,
+    .url_seek            = ffstreamer_seek,
+    .url_close           = ffstreamer_close,
+    .priv_data_size      = sizeof(FFStreamerContext),
+    .priv_data_class     = &ffstreamer_class,
+    .default_whitelist   = "ffstreamer",
+};
